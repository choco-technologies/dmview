; dmview.rules - libsystemd device rule.
;
; Every node dmdevfs reports as "display" (it answers the standard graphics
; ioctls - see dmdevfs' "libsystemd Device Reporting") gets its own
; dmview@<name> instance, instantiated on demand from dmview@.ini.
;
; Load with libsystemd_load_rules() on the directory this file lives in -
; see dmsystem's docs/configuration.md ("Device rules").
[class=display]
start=dmview@%name
