draw:
        FILL    g1
        RECT    0, 0, 480, 10, g2
        RECT    0, 790, 480, 10, g3
        RECT    0, 10, 10, 780, g4
        RECT    470, 10, 10, 780, g5
        BOX     @home_screen, -3, 24, 487, 776
        OPACITY $home_screen_alpha
        RECT    31, 196, 424, 4, g6
        RECT    19, 196, 12, 4, g7
        RECT    455, 196, 12, 4, g8
        RECT    31, 196, 424, 16, g9
        RECT    13, 162, 6, 32, g10
        RECT    467, 162, 6, 32, g11
        RECT    13, 144, 6, 18, g12
        RECT    467, 144, 6, 18, g13
        RECT    13, 196, 18, 16, g14
        RECT    13, 194, 6, 2, g15
        RECT    455, 196, 18, 16, g16
        RECT    467, 194, 6, 2, g17
        BOX     @box2, 19, 140, 448, 56
        ON      CLICK, h2
        JNE     $box.pressed, 0, .g1
        RRECT   0, 0, 448, 56, 12, #1AFFFFFF
        RFRAME  0, 0, 448, 56, 12, 1, #33FFFFFF
        TEXT    59, 12, 43, 18, "22°C", inter_semibold_14, #FFFFFF, LEFT|TOP
        TEXT    59, 32, 57, 13, "Banino, PL", inter_regular_10, #B3FFFFFF, LEFT|TOP
        TEXT    17, 17, 42, 24, "\xEF\x9B\x84", icons_solid_24, #0F000000, LEFT|TOP
        TEXT    17, 17, 42, 24, "\xEF\x9B\x84", icons_solid_24, #1A000000, LEFT|TOP
        TEXT    17, 16, 42, 24, "\xEF\x9B\x84", icons_solid_24, #FDE047, LEFT|TOP
.g1:
        JNE     $box.pressed, 1, .g2
        BOX     @box3, 0, 0, 448, 56
        OPACITY 204
        RRECT   0, 0, 448, 56, 12, #1AFFFFFF
        RFRAME  0, 0, 448, 56, 12, 1, #33FFFFFF
        TEXT    59, 12, 43, 18, "22°C", inter_semibold_14, #FFFFFF, LEFT|TOP
        TEXT    59, 32, 57, 13, "Banino, PL", inter_regular_10, #B3FFFFFF, LEFT|TOP
        TEXT    17, 17, 42, 24, "\xEF\x9B\x84", icons_solid_24, #0F000000, LEFT|TOP
        TEXT    17, 17, 42, 24, "\xEF\x9B\x84", icons_solid_24, #1A000000, LEFT|TOP
        TEXT    17, 16, 42, 24, "\xEF\x9B\x84", icons_solid_24, #FDE047, LEFT|TOP
        END
.g2:
        END
        BOX     @box4, 19, 220, 144, 69
        ON      CLICK, h4
        JNE     $box.pressed, 0, .g3
        RRECT   48, 0, 48, 48, 12, g18
        RECT    49, 1, 46, 4, g19
        RECT    49, 5, 2, 42, g20
        RECT    93, 5, 2, 42, g21
        RFRAME  48, 0, 48, 48, 12, 1, #1AFFFFFF
        TEXT    62, 14, 30, 21, "\xEF\x80\x93", icons_solid_20, #E5E7EB, LEFT|TOP
        TEXT    46, 55, 59, 13, "Ustawienia", inter_medium_10, #E6FFFFFF, LEFT|TOP
.g3:
        JNE     $box.pressed, 1, .g4
        BOX     @box5, 46, 0, 59, 68
        OPACITY 204
        RRECT   2, 0, 48, 48, 12, g18
        RECT    3, 1, 46, 4, g19
        RECT    3, 5, 2, 42, g20
        RECT    47, 5, 2, 42, g21
        RFRAME  2, 0, 48, 48, 12, 1, #1AFFFFFF
        TEXT    16, 14, 30, 21, "\xEF\x80\x93", icons_solid_20, #E5E7EB, LEFT|TOP
        TEXT    0, 55, 59, 13, "Ustawienia", inter_medium_10, #E6FFFFFF, LEFT|TOP
        END
.g4:
        END
        BOX     @box6, 171, 220, 144, 69
        ON      CLICK, h6
        JNE     $box.pressed, 0, .g5
        RRECT   48, 0, 48, 48, 12, g22
        RECT    49, 1, 46, 4, g19
        RECT    49, 5, 2, 42, g20
        RECT    93, 5, 2, 42, g21
        RFRAME  48, 0, 48, 48, 12, 1, #1AFFFFFF
        TEXT    62, 14, 30, 21, "\xEF\x8B\x9B", icons_solid_20, #FFFFFF, LEFT|TOP
        TEXT    55, 55, 41, 13, "System", inter_medium_10, #E6FFFFFF, LEFT|TOP
.g5:
        JNE     $box.pressed, 1, .g6
        BOX     @box7, 48, 0, 48, 68
        OPACITY 204
        RRECT   0, 0, 48, 48, 12, g22
        RECT    1, 1, 46, 4, g19
        RECT    1, 5, 2, 42, g20
        RECT    45, 5, 2, 42, g21
        RFRAME  0, 0, 48, 48, 12, 1, #1AFFFFFF
        TEXT    14, 14, 30, 21, "\xEF\x8B\x9B", icons_solid_20, #FFFFFF, LEFT|TOP
        TEXT    7, 55, 41, 13, "System", inter_medium_10, #E6FFFFFF, LEFT|TOP
        END
.g6:
