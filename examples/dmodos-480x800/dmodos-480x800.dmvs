; Every running animation one frame further: progress 0 ... 1000, eased
animate:
        JEQ     $home_screen_alpha_on, 0, .n4
        SET     $anim_p, $time
        SUB     $anim_p, $home_screen_alpha_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $home_screen_alpha_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $home_screen_alpha_ease, 1, .e4_1
        CALL    ease1
.e4_1:
        JNE     $home_screen_alpha_ease, 2, .e4_2
        CALL    ease2
.e4_2:
        SET     $home_screen_alpha, $home_screen_alpha_to
        SUB     $home_screen_alpha, $home_screen_alpha_from
        MUL     $home_screen_alpha, $anim_e
        DIV     $home_screen_alpha, 1000
        ADD     $home_screen_alpha, $home_screen_alpha_from
        JLT     $anim_p, 1000, .n4
        SET     $home_screen_alpha_on, 0
.n4:
        JEQ     $app_weather_y_on, 0, .n5
        SET     $anim_p, $time
        SUB     $anim_p, $app_weather_y_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $app_weather_y_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $app_weather_y_ease, 1, .e5_1
        CALL    ease1
.e5_1:
        JNE     $app_weather_y_ease, 2, .e5_2
        CALL    ease2
.e5_2:
        SET     $app_weather_y, $app_weather_y_to
        SUB     $app_weather_y, $app_weather_y_from
        MUL     $app_weather_y, $anim_e
        DIV     $app_weather_y, 1000
        ADD     $app_weather_y, $app_weather_y_from
        JLT     $anim_p, 1000, .n5
        SET     $app_weather_y_on, 0
.n5:
        JEQ     $app_settings_y_on, 0, .n6
        SET     $anim_p, $time
        SUB     $anim_p, $app_settings_y_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $app_settings_y_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $app_settings_y_ease, 1, .e6_1
        CALL    ease1
.e6_1:
        JNE     $app_settings_y_ease, 2, .e6_2
        CALL    ease2
.e6_2:
        SET     $app_settings_y, $app_settings_y_to
        SUB     $app_settings_y, $app_settings_y_from
        MUL     $app_settings_y, $anim_e
        DIV     $app_settings_y, 1000
        ADD     $app_settings_y, $app_settings_y_from
        JLT     $anim_p, 1000, .n6
        SET     $app_settings_y_on, 0
.n6:
        JEQ     $app_system_y_on, 0, .n7
        SET     $anim_p, $time
        SUB     $anim_p, $app_system_y_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $app_system_y_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $app_system_y_ease, 1, .e7_1
        CALL    ease1
.e7_1:
        JNE     $app_system_y_ease, 2, .e7_2
        CALL    ease2
.e7_2:
        SET     $app_system_y, $app_system_y_to
        SUB     $app_system_y, $app_system_y_from
        MUL     $app_system_y, $anim_e
        DIV     $app_system_y, 1000
        ADD     $app_system_y, $app_system_y_from
        JLT     $anim_p, 1000, .n7
        SET     $app_system_y_on, 0
.n7:
        JEQ     $app_music_y_on, 0, .n8
        SET     $anim_p, $time
        SUB     $anim_p, $app_music_y_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $app_music_y_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $app_music_y_ease, 1, .e8_1
        CALL    ease1
.e8_1:
        JNE     $app_music_y_ease, 2, .e8_2
        CALL    ease2
.e8_2:
        SET     $app_music_y, $app_music_y_to
        SUB     $app_music_y, $app_music_y_from
        MUL     $app_music_y, $anim_e
        DIV     $app_music_y, 1000
        ADD     $app_music_y, $app_music_y_from
        JLT     $anim_p, 1000, .n8
        SET     $app_music_y_on, 0
.n8:
        JEQ     $app_home_y_on, 0, .n9
        SET     $anim_p, $time
        SUB     $anim_p, $app_home_y_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $app_home_y_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $app_home_y_ease, 1, .e9_1
        CALL    ease1
.e9_1:
        JNE     $app_home_y_ease, 2, .e9_2
        CALL    ease2
.e9_2:
        SET     $app_home_y, $app_home_y_to
        SUB     $app_home_y, $app_home_y_from
        MUL     $app_home_y, $anim_e
        DIV     $app_home_y, 1000
        ADD     $app_home_y, $app_home_y_from
        JLT     $anim_p, 1000, .n9
        SET     $app_home_y_on, 0
.n9:
        JEQ     $app_store_y_on, 0, .n10
        SET     $anim_p, $time
        SUB     $anim_p, $app_store_y_t0
        MUL     $anim_p, 1000
        DIV     $anim_p, $app_store_y_dur
        CLAMP   $anim_p, 0, 1000
        JNE     $app_store_y_ease, 1, .e10_1
        CALL    ease1
.e10_1:
        JNE     $app_store_y_ease, 2, .e10_2
        CALL    ease2
.e10_2:
        SET     $app_store_y, $app_store_y_to
        SUB     $app_store_y, $app_store_y_from
        MUL     $app_store_y, $anim_e
        DIV     $app_store_y, 1000
        ADD     $app_store_y, $app_store_y_from
        JLT     $anim_p, 1000, .n10
        SET     $app_store_y_on, 0
.n10:
        RET

; cubic-bezier(400, 0, 200, 1000) / 1000: $anim_p -> $anim_e
ease1:
        JGE     $anim_p, 62, .s0
        SET     $anim_e, $anim_p
        SUB     $anim_e, 0
        MUL     $anim_e, 9
        DIV     $anim_e, 62
        ADD     $anim_e, 0
        RET
.s0:
        JGE     $anim_p, 125, .s1
        SET     $anim_e, $anim_p
        SUB     $anim_e, 62
        MUL     $anim_e, 34
        DIV     $anim_e, 63
        ADD     $anim_e, 9
        RET
.s1:
        JGE     $anim_p, 187, .s2
        SET     $anim_e, $anim_p
        SUB     $anim_e, 125
        MUL     $anim_e, 71
        DIV     $anim_e, 62
        ADD     $anim_e, 43
        RET
.s2:
        JGE     $anim_p, 250, .s3
        SET     $anim_e, $anim_p
        SUB     $anim_e, 187
        MUL     $anim_e, 123
        DIV     $anim_e, 63
        ADD     $anim_e, 114
        RET
.s3:
        JGE     $anim_p, 312, .s4
        SET     $anim_e, $anim_p
        SUB     $anim_e, 250
        MUL     $anim_e, 164
        DIV     $anim_e, 62
        ADD     $anim_e, 237
        RET
.s4:
        JGE     $anim_p, 375, .s5
        SET     $anim_e, $anim_p
        SUB     $anim_e, 312
        MUL     $anim_e, 159
        DIV     $anim_e, 63
        ADD     $anim_e, 401
        RET
.s5:
        JGE     $anim_p, 437, .s6
        SET     $anim_e, $anim_p
        SUB     $anim_e, 375
        MUL     $anim_e, 124
        DIV     $anim_e, 62
        ADD     $anim_e, 560
        RET
.s6:
        JGE     $anim_p, 500, .s7
        SET     $anim_e, $anim_p
        SUB     $anim_e, 437
        MUL     $anim_e, 92
        DIV     $anim_e, 63
        ADD     $anim_e, 684
        RET
.s7:
        JGE     $anim_p, 562, .s8
        SET     $anim_e, $anim_p
        SUB     $anim_e, 500
        MUL     $anim_e, 68
        DIV     $anim_e, 62
        ADD     $anim_e, 776
        RET
.s8:
        JGE     $anim_p, 625, .s9
        SET     $anim_e, $anim_p
        SUB     $anim_e, 562
        MUL     $anim_e, 50
        DIV     $anim_e, 63
        ADD     $anim_e, 844
        RET
.s9:
        JGE     $anim_p, 687, .s10
        SET     $anim_e, $anim_p
        SUB     $anim_e, 625
        MUL     $anim_e, 38
        DIV     $anim_e, 62
        ADD     $anim_e, 894
        RET
.s10:
        JGE     $anim_p, 750, .s11
        SET     $anim_e, $anim_p
        SUB     $anim_e, 687
        MUL     $anim_e, 27
        DIV     $anim_e, 63
        ADD     $anim_e, 932
        RET
.s11:
        JGE     $anim_p, 812, .s12
        SET     $anim_e, $anim_p
        SUB     $anim_e, 750
        MUL     $anim_e, 20
        DIV     $anim_e, 62
        ADD     $anim_e, 959
        RET
.s12:
        JGE     $anim_p, 875, .s13
        SET     $anim_e, $anim_p
        SUB     $anim_e, 812
        MUL     $anim_e, 12
        DIV     $anim_e, 63
        ADD     $anim_e, 979
        RET
.s13:
        JGE     $anim_p, 937, .s14
        SET     $anim_e, $anim_p
        SUB     $anim_e, 875
        MUL     $anim_e, 7
        DIV     $anim_e, 62
        ADD     $anim_e, 991
        RET
.s14:
        JGE     $anim_p, 1000, .s15
        SET     $anim_e, $anim_p
        SUB     $anim_e, 937
        MUL     $anim_e, 2
        DIV     $anim_e, 63
        ADD     $anim_e, 998
        RET
.s15:
